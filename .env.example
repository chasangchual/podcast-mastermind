# Copy to .env (default) or e.g. .env.prod and select it with APP_ENV_FILE=.env.prod
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8801

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=podcast_mastermind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=podcast-mastermind

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_API_KEY=
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# Langfuse (optional; health check only for now)
LANGFUSE_HOST=
LANGFUSE_WEB_PORT=3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Embeddings: openai_compatible | gemini
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIMENSION=1024
EMBEDDING_SEND_DIMENSIONS=false
GEMINI_API_KEY=

# Transcription: faster_whisper (Linux/macOS, CPU or CUDA) | mlx (Apple Silicon)
TRANSCRIPTION_BACKEND=faster_whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=0
WHISPER_BEAM_SIZE=1

DIARIZATION_ENABLED=false
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HUGGINGFACE_TOKEN=
PODCAST_DATA_PATH=./data
HTTP_USER_AGENT=podcast-mastermind/0.1 (+private local transcript index)
TRANSCRIPT_MIN_WORDS=150
